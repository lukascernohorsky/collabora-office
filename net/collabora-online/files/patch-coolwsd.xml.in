--- coolwsd.xml.in.orig	2026-02-02 17:45:08.449131000 +0100
+++ coolwsd.xml.in	2026-02-02 17:48:05.543815000 +0100
@@ -34,12 +34,12 @@
         <auth_key desc="Auth Key generated by your account" type="string" default=""></auth_key>
     </deepl>
